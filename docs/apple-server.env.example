# Install these values only in the backend secret store. Never ship them in Expo or NEXT_PUBLIC variables.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=

# Keep false until payment/membership Firestore rules and credentials have been reviewed.
# Enable in an isolated testing environment first; complete real StoreKit tests before production.
APPLE_IAP_SECURITY_READY=false

# Canonical Urologics IDs for dedicated TestFlight / App Review sandbox accounts only.
APPLE_SANDBOX_USER_IDS=
